# Python virtual environment
venv/
env/
.venv/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Pytest / coverage cache
.pytest_cache/
.coverage
htmlcov/

# Local instance and database files
instance/*.sqlite
instance/*.db
*.sqlite3
*.db

# User-uploaded files (keep the directory structure in Git via .gitkeep)
uploads/*
!uploads/.gitkeep

# Environment and sensitive configuration
.env
.env.*
*.secret

# IDE and OS files
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
